{
  "name": "ksana-ears-platform",
  "version": "2.4.0",
  "description": "EARS — Effortless Assessment Research System by Ksana Health",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:pipeline": "jest --testPathPattern=tests/integration/pipeline",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "verify:deidentification": "ts-node scripts/verify-deidentification.ts",
    "audit:logs": "ts-node scripts/audit-log-phi-scan.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@azure/identity": "^4.2.0",
    "@azure/keyvault-keys": "^4.8.0",
    "@azure/storage-blob": "^12.18.0",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "uuid": "^10.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "coverageDirectory": "coverage",
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.test.json"
      }
    },
    "coverageThreshold": {
      "global": {
        "branches": 80,
        "functions": 80,
        "lines": 80,
        "statements": 80
      }
    },
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ]
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "private": true,
  "license": "UNLICENSED"
}
